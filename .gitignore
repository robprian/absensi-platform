# Secrets & environment lokal
.env

# Hasil backup (jangan commit; simpan di lokasi aman terpisah)
backups/
*.sql.gz
*.tar.gz

# Volume / data lokal
data/

# Build artefacts
.DS_Store

# Dependencies (di-install saat build)
node_modules/
apps/*/node_modules/
vendor/
apps/*/vendor/

# Build outputs
apps/employee-pwa/build/
apps/employee-pwa/.svelte-kit/
apps/admin-backend/bootstrap/cache/*.php
!apps/admin-backend/bootstrap/cache/.gitignore
apps/admin-backend/storage/*.key
apps/admin-backend/public/build/

# tDocs source (di-clone oleh CI pada tag yang di-pin; lihat images.yml)
services/tdocs/

# Lock files (terlalu besar untuk transport MCP; reproducible build via CI cache)
apps/admin-backend/composer.lock
apps/employee-pwa/package-lock.json
