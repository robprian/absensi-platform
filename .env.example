# =====================================================================
# Absensi & Payroll Platform — contoh konfigurasi environment
# Salin menjadi `.env` lalu isi nilai rahasia:
#   cp .env.example .env && chmod 600 .env
# Atau jalankan ./scripts/init.sh (membuat secret otomatis bila kosong).
# JANGAN commit file .env ke git.
# =====================================================================

# ---- Domain produksi (wajib; Caddy menerbitkan sertifikat otomatis) ----
APP_DOMAIN=hadir.seperti.my.id
DOCS_DOMAIN=data.seperti.my.id

# ---- Build arg PWA: base URL API yang dipakai aplikasi karyawan ----
# "/api" = same-origin, di-proxy Caddy ke backend (disarankan, tanpa CORS).
VITE_API_BASE_URL=/api

# ---- Laravel ----
APP_NAME="Absensi Platform"
APP_ENV=production
APP_DEBUG=false
# Kosongkan -> ./scripts/init.sh membuatnya otomatis (base64: + 32 byte acak).
APP_KEY=
APP_URL=https://admin.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

# ---- Database (PostgreSQL) ----
POSTGRES_DB=absensi
POSTGRES_USER=absensi
# Kosongkan/"change-me" -> init.sh membuatnya otomatis.
POSTGRES_PASSWORD=change-me-ganti-dengan-yang-kuat

# Laravel membaca kredensial yang sama (jangan diubah manual terpisah):
DB_CONNECTION=pgsql
DB_DATABASE=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# ---- Redis (queue + cache) ----
# Opsional. Bila dikosongkan, Redis berjalan tanpa password di network
# privat (hanya bisa diakses service internal).
REDIS_PASSWORD=
REDIS_CLIENT=phpredis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# ---- tDocs ----
# Password admin tDocs. dipakai untuk:
#   1. login portal https://docs.example.com, dan
#   2. API internal Laravel -> tDocs (Authorization: Bearer <nilai ini>).
# JANGAN PERNAH diberikan ke karyawan / dibake ke aplikasi PWA.
# Kosongkan/"change-me" -> init.sh membuatnya otomatis.
TDOCS_ADMIN_PASSWORD=change-me-ganti-dengan-yang-sangat-kuat

# ---- Sanctum (token API untuk PWA) ----
# PWA memakai token Bearer, jadi tidak butuh stateful domains.
# Bila admin UI memakai SPA cookie di masa depan, isi domainnya di sini:
# SANCTUM_STATEFUL_DOMAINS=hadir.seperti.my.id

# ---- Session & cookie (admin Blade UI) ----
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ---- Mail (notifikasi: slip gaji terbit, reimburse disetujui, dsb.) ----
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Absensi Platform"

# ---- Operasional ----
TZ=Asia/Jakarta
IMAGE_TAG=latest
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# ---- Pengaturan aplikasi (dibaca Laravel; default bila kosong) ----
# REIMBURSEMENT_ENABLED=true
# PAYROLL_PERIOD_DEFAULT=monthly
